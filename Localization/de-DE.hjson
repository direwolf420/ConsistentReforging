Mods: {
	ConsistentReforging: {
		Configs: {
			Config: {
				DisplayName: Konfiguration

				ReforgeHistoryLength: {
					Label: Nachschmiede-Verlaufslänge
					Tooltip: Anzahl der Präfixe, die pro Item gespeichert werden sollen
				}

				ShowReforgeHistoryTooltip: {
					Label: Nachschmiede-Verlaufstooltip
					Tooltip: Ob der Nachschmiede-Verlauf im Item-Tooltip angezeigt werden soll (nur im Nachschmiede-UI)
				}

				ShowOrphanedReforgeHistoryTooltip: {
					Label: Tooltip für verwaiste Mod-Nachschmiede-Verläufe
					Tooltip: Zusätzlich zum 'Nachschmiede-Verlaufstooltip' werden deaktivierte Modifikationen angezeigt
				}

				SaveReforges: {
					Label: Nachschmiede-Verlauf speichern
					Tooltip: Ob der Nachschmiede-Verlauf beim Weltverlassen gespeichert und beim Beitritt geladen werden soll
				}

				PreventDuplicatesFromHistory: {
					Label: Doppelte Präfixe verhindern
					Tooltip: Ob beim Nachschmieden keine bereits im Verlauf vorhandene Modifikationen vergeben werden sollen
				}

				UndoButtonAnchor: {
					Label: "'Rückgängig'-Button Position"
					Tooltip: Wählen Sie, ob der 'Rückgängig'-Button unter oder rechts vom Nachschmiede-Button positioniert werden soll
				}
			}

			UndoButtonAnchorPosType: {
				Tooltip: ""
				Bottom.Label: Unten
				Right.Label: Rechts
			}
		}

		Common: {
			UndoLastReforge: Letzte Nachschmiede rückgängig machen (-> {0})
			NoPrefix: Keine
			PreviousPrefix: Vorherige Modifikation: {0}
		}
	}
}
